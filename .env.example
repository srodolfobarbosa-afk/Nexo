# ==========================================================
# INFRAESTRUTURA NEXO V3.0: NÚCLEO SOBERANO
# ==========================================================

# --- IA E PROCESSAMENTO ---
GEMINI_API_KEY=your_api_key_here
GROQ_API_KEY=your_api_key_here
HF_TOKEN=your_hf_token_here

# --- MEMÓRIA VETORIAL (PINECONE) ---
PINECONE_API_KEY=your_api_key_here
PINECONE_INDEX_NAME=nexo-soberano
PINECONE_ENV=us-east-1

# --- BANCO DE DADOS (SUPABASE) ---
SUPABASE_URL=https://your-instance.supabase.co
SUPABASE_KEY=your_supabase_key_here

# --- OPERAÇÕES FINANCEIRAS (MERCADO PAGO) ---
MP_ACCESS_TOKEN=your_mp_token_here
ALVO_ID=your_alvo_id_here

# --- RODÍZIO DE CHAVES (RESILIÊNCIA) ---
GROQ_KEY_1=your_groq_key_1
GROQ_KEY_2=your_groq_key_2
GROQ_KEY_3=your_groq_key_3
GROQ_KEY_4=your_groq_key_4
GROQ_KEY_5=your_groq_key_5

# --- N8N INTEGRATION ---
N8N_URL=http://localhost:5678
N8N_API_KEY=nexo_api_key

# --- CONFIGURAÇÕES ---
BASE_PATH=/app/data
DEBUG=True
PORT=7860
