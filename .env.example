# Exemplo de arquivo .env (NÃO COMMITAR valores reais)
# Copie este arquivo para .env e preencha os valores localmente.

# Chaves do Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Provedores LLM / APIs
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NEXO_LLM_PROVIDER=google

# Google Search (CSE)
GOOGLE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Outros
VERCEL_TOKEN=
GITHUB_TOKEN=
SECRET_KEY=

# Opcional: configurações locais
START_MISSION_RUNNER=1
MISSION_INTERVAL=6
# Arquivo de exemplo - copie para .env e adicione suas chaves reais

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

NEXO_LLM_PROVIDER=google

# Security / runtime
JWT_SECRET=replace-with-a-strong-secret
START_MISSION_RUNNER=1
MISSION_INTERVAL=6

# Note: Never commit a real .env to source control. Use a secrets manager (GitHub Secrets, Render, etc.)
